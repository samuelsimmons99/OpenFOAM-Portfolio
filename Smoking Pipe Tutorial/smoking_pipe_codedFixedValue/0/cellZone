FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      cellZone;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];


internalField   uniform -1;

boundaryField
{
    Inlet
    {
        type            calculated;
        value           uniform -1;
    }
    Outlet
    {
        type            calculated;
        value           uniform -1;
    }
    PipeHandle
    {
        type            calculated;
        value           uniform -1;
    }
    Walls
    {
        type            calculated;
        value           uniform -1;
    }
}


