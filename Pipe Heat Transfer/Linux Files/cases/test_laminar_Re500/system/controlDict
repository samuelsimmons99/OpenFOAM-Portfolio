FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     buoyantSimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         200;
deltaT          1;

writeControl    timeStep;
writeInterval   200;
purgeWrite      1;

writeFormat     ascii;
writePrecision  8;
runTimeModifiable true;

functions
{
    wallHeatFlux
    {
        type            wallHeatFlux;
        libs            ("libfieldFunctionObjects.so");
        patches         (wall);
        writeControl    writeTime;
        log             true;
    }
}
