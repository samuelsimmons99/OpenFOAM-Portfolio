FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}
mixture
{
    specie      { molWeight 55.85; }
    transport   { kappa 50; }         // W/m·K steel
    thermodynamics { Hf 0; Cp 500; }  // J/kg·K steel
    equationOfState { rho 7800; }     // kg/m³ steel
}
