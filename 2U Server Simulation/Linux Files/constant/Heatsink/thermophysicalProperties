FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}
mixture
{
    specie      { molWeight 26.98; }
    transport   { kappa 205; }        // W/m·K aluminium
    thermodynamics { Hf 0; Cp 900; }  // J/kg·K aluminium
    equationOfState { rho 2700; }     // kg/m³ aluminium
}
