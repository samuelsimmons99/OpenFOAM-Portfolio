FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}
mixture
{
    specie      { molWeight 28.1; }
    transport   { kappa 150; }       // W/m·K silicon
    thermodynamics { Hf 0; Cp 700; } // J/kg·K silicon
    equationOfState { rho 2330; }    // kg/m³ silicon
}
