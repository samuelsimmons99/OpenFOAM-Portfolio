FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    combined_m.stl
    {
        type triSurfaceMesh;
        file "combined_m.stl";
        regions
        {
            FRONT_PANEL      { name FRONT_PANEL; }
            Fan_front_blades { name Fan_front_blades; }
            Fan_front_frame  { name Fan_front_frame; }
            Fan_front_inlet  { name Fan_front_inlet; }
            Fan_front_outlet { name Fan_front_outlet; }
            fan_rear1_blades { name fan_rear1_blades; }
            fan_rear1_frame  { name fan_rear1_frame; }
            fan_rear1_inlet  { name fan_rear1_inlet; }
            fan_rear1_outlet { name fan_rear1_outlet; }
            fan_rear2_blades { name fan_rear2_blades; }
            fan_rear2_frame  { name fan_rear2_frame; }
            fan_rear2_inlet  { name fan_rear2_inlet; }
            fan_rear2_outlet { name fan_rear2_outlet; }
            SMALL_chip1      { name SMALL_chip1; }
            SMALL_chip2      { name SMALL_chip2; }
            SMALL_chip3      { name SMALL_chip3; }
            SMALL_PCB        { name SMALL_PCB; }
            MINI_BOARD       { name MINI_BOARD; }
            Motherboard      { name Motherboard; }
            CPU              { name CPU; }
            TIM              { name TIM; }
            Heatsink         { name Heatsink; }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      6000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features ();

    refinementSurfaces
    {
        combined_m.stl
        {
            level (2 2);
            regions
            {
                FRONT_PANEL
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    FRONT_PANEL;
                    faceZone    FRONT_PANEL;
                    cellZoneInside inside;
                }
                Fan_front_blades { level (1 1); patchInfo { type wall; } }
                Fan_front_frame  { level (2 2); patchInfo { type wall; } }
                Fan_front_inlet  { level (2 2); patchInfo { type patch; } }
                Fan_front_outlet { level (2 2); patchInfo { type patch; } }
                fan_rear1_blades { level (1 1); patchInfo { type wall; } }
                fan_rear1_frame  { level (2 2); patchInfo { type wall; } }
                fan_rear1_inlet  { level (2 2); patchInfo { type patch; } }
                fan_rear1_outlet { level (2 2); patchInfo { type patch; } }
                fan_rear2_blades { level (1 1); patchInfo { type wall; } }
                fan_rear2_frame  { level (2 2); patchInfo { type wall; } }
                fan_rear2_inlet  { level (2 2); patchInfo { type patch; } }
                fan_rear2_outlet { level (2 2); patchInfo { type patch; } }
                Motherboard
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    Motherboard;
                    faceZone    Motherboard;
                    cellZoneInside inside;
                }
                CPU
                {
                    level (3 3);
                    patchInfo { type wall; }
                    cellZone    CPU;
                    faceZone    CPU;
                    cellZoneInside inside;
                }
                TIM
                {
                    level (3 3);
                    patchInfo { type wall; }
                    cellZone    TIM;
                    faceZone    TIM;
                    cellZoneInside inside;
                }
                Heatsink
                {
                    level (3 3);
                    patchInfo { type wall; }
                    cellZone    Heatsink;
                    faceZone    Heatsink;
                    cellZoneInside inside;
                }
                SMALL_PCB
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    SMALL_PCB;
                    faceZone    SMALL_PCB;
                    cellZoneInside inside;
                }
                SMALL_chip1
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    SMALL_chip1;
                    faceZone    SMALL_chip1;
                    cellZoneInside inside;
                }
                SMALL_chip2
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    SMALL_chip2;
                    faceZone    SMALL_chip2;
                    cellZoneInside inside;
                }
                SMALL_chip3
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    SMALL_chip3;
                    faceZone    SMALL_chip3;
                    cellZoneInside inside;
                }
                MINI_BOARD
                {
                    level (2 2);
                    patchInfo { type wall; }
                    cellZone    MINI_BOARD;
                    faceZone    MINI_BOARD;
                    cellZoneInside inside;
                }
            }
        }
    }

    // No refinementRegions - cellZoneInside handles solid identification
    refinementRegions {}

    resolveFeatureAngle 60;

    // locationsInMesh: one point per region
    // First entry (none) = fluid (air) region kept by snappy
    // Subsequent entries = solid cellZones snappy creates inside each solid
    // CPU centre from STL: X~131mm, Y~15.6mm, Z~0mm (in metres after scaling)
    locationsInMesh
    (
        ( (0 0.05 0)            none        )
        ( (0.1314 0.0156 0)     CPU         )
        ( (0.1314 0.017 0)      TIM         )
        ( (0.1314 0.025 0)      Heatsink    )
        ( (0.05 0.001 0)        Motherboard )
        ( (0.1314 0.001 0)      SMALL_PCB   )
        ( (-0.1 0.001 0)        MINI_BOARD  )
        ( (0.1314 0.001 0.05)   FRONT_PANEL )
    );

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes       true;
    layers {}
    expansionRatio      1.2;
    finalLayerThickness 0.3;
    minThickness        0.1;
    nGrow               0;
    featureAngle        60;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       -1e30;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     75;
        minVol          -1e30;
        minTetQuality   -1e30;
        minTwist        -1;
    }
}

mergeTolerance 1e-6;
