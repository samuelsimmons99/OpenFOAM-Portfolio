FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
solvers
{
    p_rgh
    {
        solver          GAMG;
        tolerance       1e-7;
        relTol          0.01;
        smoother        DICGaussSeidel;
    }
    p_rghFinal { $p_rgh; relTol 0; }
    rho { solver diagonal; }
    rhoFinal { $rho; }
    "(U|h|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }
    "(U|h|k|epsilon)Final" { $U; relTol 0; }
}
SIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    1;
    nCorrectors         2;
    nNonOrthogonalCorrectors 2;
    residualControl
    {
        p_rgh           1e-4;
        U               1e-4;
        h               1e-4;
        k               1e-4;
        epsilon         1e-4;
    }
}
relaxationFactors
{
    fields  { rho 1.0; p_rgh 0.7; }
    equations { U 0.7; h 0.5; k 0.5; epsilon 0.5; }
}
