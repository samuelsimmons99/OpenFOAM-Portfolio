    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    top
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    sides
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    fluid_to_solid
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}
