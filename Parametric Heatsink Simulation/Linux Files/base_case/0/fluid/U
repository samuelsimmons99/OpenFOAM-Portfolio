FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -2.86);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 -2.86);  // flow in -Z direction
    }

    outlet
    {
        type            zeroGradient;
    }

    top
    {
        type            noSlip;
    }

    sides
    {
        type            noSlip;
    }

    fluid_to_solid
    {
        type            noSlip;
    }
}
